{
  "test_description": "Comprehensive vendor configuration update API test",
  "endpoint": "PUT /api/admin/vendor-configs/{id}/complete",
  "headers": {
    "Content-Type": "application/json",
    "Authorization": "Bearer YOUR_ADMIN_JWT_TOKEN"
  },
  "sample_payloads": {
    "complete_update": {
      "razorpayVendorId": "acc_M5z6J8K9L0m1N2o3P4q5",
      "cutValue": 5.5,
      "cutType": "percentage",
      "isRazorpayActive": true,
      "onboardingStatus": "completed",
      "onboardingDate": "2024-01-15T10:30:00.000Z",
      "bankAccountVerified": true,
      "kycStatus": "verified",
      "activeStatus": true,
      "razorpayBankAccountId": "ba_G7h8I9j0K1L2m3N4o5P6",
      "razorpayStakeholderId": "stakeholder_Q7r8S9t0U1v2W3x4Y5z6",
      "updatedBy": "admin@gym.com"
    },
    "partial_update_commission_only": {
      "cutValue": 3.0,
      "cutType": "percentage"
    },
    "partial_update_status_only": {
      "onboardingStatus": "pending_verification",
      "kycStatus": "submitted",
      "bankAccountVerified": false
    },
    "partial_update_razorpay_only": {
      "razorpayVendorId": "acc_N6o7P8q9R0s1T2u3V4w5",
      "razorpayBankAccountId": "ba_H8i9J0k1L2m3N4o5P6q7",
      "razorpayStakeholderId": "stakeholder_R8s9T0u1V2w3X4y5Z6a7",
      "isRazorpayActive": true
    }
  },
  "curl_examples": {
    "complete_update": "curl -X PUT 'http://localhost:3000/api/admin/vendor-configs/1/complete' \\\n  -H 'Content-Type: application/json' \\\n  -H 'Authorization: Bearer YOUR_JWT_TOKEN' \\\n  -d '{\n    \"razorpayVendorId\": \"acc_M5z6J8K9L0m1N2o3P4q5\",\n    \"cutValue\": 5.5,\n    \"cutType\": \"percentage\",\n    \"isRazorpayActive\": true,\n    \"onboardingStatus\": \"completed\",\n    \"onboardingDate\": \"2024-01-15T10:30:00.000Z\",\n    \"bankAccountVerified\": true,\n    \"kycStatus\": \"verified\",\n    \"activeStatus\": true,\n    \"razorpayBankAccountId\": \"ba_G7h8I9j0K1L2m3N4o5P6\",\n    \"razorpayStakeholderId\": \"stakeholder_Q7r8S9t0U1v2W3x4Y5z6\",\n    \"updatedBy\": \"admin@gym.com\"\n  }'",
    "commission_update": "curl -X PUT 'http://localhost:3000/api/admin/vendor-configs/1/complete' \\\n  -H 'Content-Type: application/json' \\\n  -H 'Authorization: Bearer YOUR_JWT_TOKEN' \\\n  -d '{\n    \"cutValue\": 7.5,\n    \"cutType\": \"percentage\"\n  }'"
  },
  "expected_responses": {
    "success": {
      "success": true,
      "message": "Vendor configuration updated successfully",
      "data": {
        "id": 1,
        "ownerEmail": "owner@example.com",
        "gymId": 1,
        "razorpayVendorId": "acc_M5z6J8K9L0m1N2o3P4q5",
        "cutValue": 5.5,
        "cutType": "percentage",
        "isRazorpayActive": true,
        "onboardingStatus": "completed",
        "onboardingDate": "2024-01-15T10:30:00.000Z",
        "bankAccountVerified": true,
        "kycStatus": "verified",
        "activeStatus": true,
        "razorpayBankAccountId": "ba_G7h8I9j0K1L2m3N4o5P6",
        "razorpayStakeholderId": "stakeholder_Q7r8S9t0U1v2W3x4Y5z6",
        "createTimestamp": "2024-01-01T00:00:00.000Z",
        "createdBy": "admin@gym.com",
        "updateTimestamp": "2024-01-15T10:30:00.000Z",
        "updatedBy": "admin@gym.com",
        "gym": {
          "id": 1,
          "name": "Example Gym",
          "address": "123 Main St",
          "city": "Example City"
        }
      },
      "timestamp": "2024-01-15T10:30:00.000Z"
    },
    "validation_error": {
      "success": false,
      "message": "Invalid onboarding status",
      "data": null,
      "timestamp": "2024-01-15T10:30:00.000Z"
    },
    "not_found": {
      "success": false,
      "message": "Vendor configuration not found",
      "data": null,
      "timestamp": "2024-01-15T10:30:00.000Z"
    }
  },
  "validation_rules": {
    "cutValue": "Must be greater than 0. If cutType is 'percentage', must not exceed 100",
    "cutType": "Must be 'percentage' or 'flat'",
    "onboardingStatus": "Must be one of: 'pending', 'in_progress', 'pending_verification', 'completed', 'rejected'",
    "kycStatus": "Must be one of: 'pending', 'submitted', 'verified', 'rejected'",
    "onboardingDate": "Must be a valid ISO 8601 date string",
    "isRazorpayActive": "Must be boolean",
    "bankAccountVerified": "Must be boolean",
    "activeStatus": "Must be boolean"
  },
  "notes": [
    "All fields are optional - only provided fields will be updated",
    "The API performs comprehensive validation on all fields",
    "Date fields accept ISO 8601 format strings",
    "The response includes the updated record with gym relationship populated",
    "Admin authentication is required via JWT token"
  ]
}
