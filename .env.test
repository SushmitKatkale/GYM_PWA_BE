NODE_ENV=test

# Test Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gym_pwa_test
DB_USER=root
DB_PASSWORD=root

# JWT Configuration
JWT_SECRET=test_jwt_secret_key_for_testing_only
JWT_EXPIRES_IN=1h

# Test-specific settings
TEST_TIMEOUT=30000
LOG_LEVEL=error

# Disable external services for testing
DISABLE_EMAIL=true
DISABLE_PUSH_NOTIFICATIONS=true
DISABLE_PAYMENT_GATEWAY=true

# Test server configuration
PORT=3001
